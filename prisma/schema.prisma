generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Provider {
  id          String    @id @default(cuid())
  fullName    String
  email       String?
  phone       String?
  serviceId   String
  cityId      String
  address     String?
  latitude    Float?
  longitude   Float?
  description String?
  picturePath String?
  featured    Boolean   @default(false)
  active      Boolean   @default(false)
  paidUntil   DateTime?
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?
  removalDeadline DateTime?
  salesExempt     Boolean   @default(false)
  scheduledSendAt DateTime?
  placeId         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviews      Review[]
  appointments AppointmentRequest[]
  missions     GameMission[]
  salesContacts SalesContact[]
}

model AppointmentRequest {
  id              String   @id @default(cuid())
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  message         String?
  createdAt       DateTime @default(now())
}

model ServiceRequest {
  id           String   @id @default(cuid())
  title        String
  description  String?
  serviceId    String?
  cityId       String?
  contactName  String
  contactEmail String?
  contactPhone String?
  budget       String?
  createdAt    DateTime @default(now())
  active       Boolean  @default(true)
}

model Review {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model AccessCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Article {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  excerpt           String?
  content           String   @db.Text
  coverImagePath    String?
  coverImageCredit  String?
  coverImageCreditUrl String?
  relatedServiceId  String?
  relatedCityId     String?
  published         Boolean  @default(false)
  source            String   @default("manual") // "manual" | "autopilot"
  views             Int      @default(0)
  ctaClicks         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GameMission {
  id               String   @id @default(cuid())
  providerId       String
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rewardPoints     Int
  isGrandChallenge Boolean  @default(false)
  expiresAt        DateTime
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  submissions      GameSubmission[]
}

model SalesContact {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type       String   // "pitch" | "reminder"
  sentAt     DateTime @default(now())
}

model GameSubmission {
  id            String      @id @default(cuid())
  deviceId      String?
  nickname      String?
  playerId      String?
  player        Player?     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId     String
  mission       GameMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  photoPath     String
  status        String      @default("pending")
  pointsAwarded Int?
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?
}

model Player {
  id             String           @id // Google `sub` — stable identifier, not a generated cuid
  email          String?
  name           String?
  picture        String?
  nickname       String?
  createdAt      DateTime         @default(now())
  submissions    GameSubmission[]
  payoutRequests PayoutRequest[]
}

model PayoutRequest {
  id             String    @id @default(cuid())
  playerId       String
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  pointsSpent    Int       @default(1000)
  amountCzk      Int       @default(200)
  accountName    String
  accountDetails String
  status         String    @default("pending") // pending | paid
  createdAt      DateTime  @default(now())
  paidAt         DateTime?
}

model ProcurementNotice {
  id               String   @id @default(cuid())
  externalId       String   @unique // poptavej.cz listing ID (e.g. VZ819883) — dedup key across scrapes
  title            String
  description      String?  @db.Text
  cpvCode          String?  // category name, e.g. "Stavebnictví"
  regionCode       String?  // region name, e.g. "Zlínský"
  relatedServiceId String?  // mapped from category where possible
  status           String?  // deadline text, e.g. "31 dní do ukončení"
  estimatedValue   Float?
  publishedAt      DateTime? // when the listing was published on the source site
  sourceUrl        String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}
